<!-- Native Blogger layout sections. Keep b:section children limited to b:widget elements. -->
<header class='site-header' id='site-header'>
  <div class='container site-header__inner'>
    <b:section id='header' class='header' name='Header' maxwidgets='1' showaddelement='yes'>
      <b:widget id='Header1' type='Header' version='2' locked='false' title='Blog Header' visible='true'>
        <b:widget-settings>
          <b:widget-setting name='displayUrl'/>
          <b:widget-setting name='displayHeight'>0</b:widget-setting>
          <b:widget-setting name='sectionWidth'>-1</b:widget-setting>
          <b:widget-setting name='useImage'>false</b:widget-setting>
          <b:widget-setting name='shrinkToFit'>false</b:widget-setting>
          <b:widget-setting name='imagePlacement'>BEHIND</b:widget-setting>
          <b:widget-setting name='displayWidth'>0</b:widget-setting>
        </b:widget-settings>
      </b:widget>
    </b:section>

    <button class='menu-toggle' type='button' aria-controls='site-navigation' aria-expanded='false' aria-label='Toggle navigation'>
      <span class='menu-toggle__line'></span>
      <span class='menu-toggle__line'></span>
      <span class='menu-toggle__line'></span>
    </button>

    <nav class='site-navigation' id='site-navigation' aria-label='Primary navigation'>
      <b:section id='navigation' class='navigation' name='Navigation' maxwidgets='1' showaddelement='yes'>
        <b:widget id='PageList1' type='PageList' version='2' locked='false' title='Pages' visible='true'>
          <b:widget-settings>
            <b:widget-setting name='pageListJson'><![CDATA[{}]]></b:widget-setting>
            <b:widget-setting name='homeTitle'>Home</b:widget-setting>
          </b:widget-settings>
        </b:widget>
      </b:section>
    </nav>
  </div>
</header>
