<!--
  Blogger Dev Architect - Post Component
  --------------------------------------
  Reusable Blog1 post includable.

  This fragment is assembled inside Blog1 and receives the current
  post object through var='post'.
-->

<b:includable id='post' var='post'>
  <article class='blog-post' expr:id='&quot;post-&quot; + data:post.id'>
    <header class='blog-post__header'>
      <h2 class='blog-post__title'>
        <a class='blog-post__title-link' expr:href='data:post.url'>
          <data:post.title/>
        </a>
      </h2>

      <div class='blog-post__meta'>
        <span class='blog-post__date'>
          <data:post.timestamp/>
        </span>

        <b:if cond='data:post.author'>
          <span class='blog-post__separator'>•</span>
          <span class='blog-post__author'>
            <data:post.author/>
          </span>
        </b:if>
      </div>
    </header>

    <div class='blog-post__content'>
      <data:post.body/>
    </div>

    <b:if cond='data:blog.pageType == &quot;item&quot;'>
      <div class='blog-post__comments'>
        <b:if cond='data:post.allowComments'>
          <a class='blog-post__comments-link' expr:href='data:post.addCommentUrl'>
            <b:eval expr='data:post.numComments == 1 ? &quot;1 comment&quot; : data:post.numComments + &quot; comments&quot;'/>
          </a>
        <b:else/>
          <span class='blog-post__comments-disabled'>Comments are closed.</span>
        </b:if>
      </div>
    </b:if>

    <b:if cond='data:post.labels'>
      <footer class='blog-post__footer'>
        <div class='blog-post__labels' aria-label='Post labels'>
          <b:loop values='data:post.labels' var='label'>
            <a class='blog-post__label' expr:href='data:label.url' rel='tag'>
              <data:label.name/>
            </a>
          </b:loop>
        </div>
      </footer>
    </b:if>
  </article>
</b:includable>
