<!--
  Blogger Dev Architect - Sidebar Component
  ------------------------------------------
  Editable HTML sidebar widget.
-->

<aside class='sidebar-area' aria-label='Sidebar'>
  <b:section
    id='sidebar'
    class='sidebar'
    maxwidgets='5'
    showaddelement='yes'>
    <b:widget
      id='HTML1'
      type='HTML'
      version='2'
      locked='false'
      title='Sidebar'
      visible='true'>
      <b:includable id='main'>
        <div class='widget-content'>
          <data:content/>
        </div>
      </b:includable>
    </b:widget>
  </b:section>
</aside>
